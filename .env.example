# Copy to .env and edit. Every variable is optional: with none of them set the
# firewall runs in monitor mode with the non-learned layers and records nothing.
#
# This file contains no secrets and never will. This package authenticates to
# nothing, downloads nothing, and calls no model API. If you find yourself
# wanting to add a key here, you are configuring the thing in front of the
# firewall, not the firewall.

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

# monitor | enforce
#
# monitor  flags and records; the model is still called. The default, and the
#          recommended setting -- see docs/policy.md for why a detector with a
#          measured double-digit bypass rate should not block by default.
# enforce  blocks at or above PIFW_BLOCK_THRESHOLD. Requires PIFW_RECORD_PATH;
#          construction fails without it rather than blocking traffic silently.
PIFW_MODE=monitor

# Score at or above which a message is flagged.
#
# Do NOT keep the default in a real deployment. The right value depends on which
# layers are active and on your traffic; derive it from your own benign sample:
#
#   pifw calibrate --corpus examples/holdout.jsonl.gz --target-fpr 0.01
#
# A threshold carried over from a different configuration is not a threshold.
PIFW_FLAG_THRESHOLD=0.5

# Score at or above which enforce mode blocks. Must be >= the flag threshold.
PIFW_BLOCK_THRESHOLD=0.9

# ---------------------------------------------------------------------------
# The learned layer
# ---------------------------------------------------------------------------

# Path to a model written by `pifw train`. Without it the learned layer is off
# and the score comes from the remaining layers -- which measure far worse
# against unseen techniques. See docs/detection.md.
#
#   pifw train --corpus examples/corpus.jsonl.gz --out var/model.npz
#PIFW_MODEL_PATH=var/model.npz

# ---------------------------------------------------------------------------
# The audit record
# ---------------------------------------------------------------------------

# Where decisions are appended as JSON Lines. Required when PIFW_MODE=enforce.
#PIFW_RECORD_PATH=var/decisions.jsonl

# Store the message text alongside each decision. Off by default: a log of every
# prompt users sent an assistant is a data-protection liability that arrives
# bundled with the mitigation. Turn it on deliberately, with a retention policy.
PIFW_RECORD_TEXT=false

# Salt for the message fingerprint. Set it to a stable value and fingerprints
# correlate across process restarts, so repeat offenders can be linked. Leave it
# unset and each process generates a fresh random salt, so records link to
# nothing -- not even to yesterday's record of the same message.
#
# This is the one value in this file worth protecting: the space of short
# prompts is small enough to enumerate, so with the salt in hand a reader can
# confirm a guess about what a fingerprint stands for. It is a pseudonym, not an
# anonymisation. Generate one with:
#
#   python -c "import secrets; print(secrets.token_hex(16))"
#
# Keep it out of version control.
#PIFW_RECORD_SALT=
